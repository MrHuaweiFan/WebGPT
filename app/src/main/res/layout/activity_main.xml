<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <WebView
        android:id="@+id/activity_main_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Loading overlay — spinning logo with fade in/out.
         Background matches device theme (black in dark mode, white in light mode).
         Stays visible until the page has fully loaded its theme to avoid white flash. -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <!-- Optional page-progress bar (Settings → Interface, off by
             default). Material 3 LinearProgressIndicator with the library's
             spec defaults (4dp track, rounded 2dp ends, gap + stop dot —
             material 1.12). BOTH painted colors are pinned to literals:
             by DAY the bar is indicator #2F628C over track #CEE5FF; in
             DARK mode the two are swapped (user request, v6.28 exp —
             indicator #CEE5FF over track #2F628C, via the
             values-night/colors.xml overrides). In both modes the
             active indicator AND the stop dot share
             loading_progress_indicator, the full-width track is
             loading_progress_track. The track had to be pinned
             too: material 1.12's DEFAULT track color is the
             colorSecondaryContainer THEME token (pale blue by day, dark
             navy #0D4A73 by night) — that theme-dependent default was the
             "still wrong in dark mode" half of the color bug after the
             indicator was already pinned; see values/colors.xml. It lives
             INSIDE the overlay so it appears exactly when the logo
             appears and fades out with the whole overlay — it never
             animates or pulses on its own. Progress is HONEST, not raw:
             chatgpt.com reports 100% before the SPA has hydrated (the
             misleading full load the loading screen's detection system
             exists for), so the bar maps the raw percentage onto 0–90%
             and is only completed to 100% by hideLoadingOverlayNow() —
             the same real-ready signal that dismisses the loading
             screen. -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/loading_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:indeterminate="false"
            android:visibility="gone"
            app:indicatorColor="@color/loading_progress_indicator"
            app:trackColor="@color/loading_progress_track" />

        <ImageView
            android:id="@+id/loading_logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/logo_black"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="loading" />

    </FrameLayout>

</FrameLayout>
