<?xml version="1.0" encoding="utf-8"?>
<!-- One installed-WebView row ("Installed" tab of the WebView Manager).

     Touch feedback (v6.27):
     - Row background = ripple_installed_row: a 12 dp rounded-rect press
       tint, the same curvature as the app's MaterialButtons ("Check for
       updates", etc.). Idle state is fully transparent, so the row's
       resting look is unchanged.
     - The MaterialRadioButton gets android:background="@null": its
       Material3 style (values-v23) installs an unbounded CIRCULAR ripple
       (m3_radiobutton_ripple), and ViewGroup.dispatchSetPressed() forwards
       pressed state to non-clickable children — so pressing the row used
       to draw a second circular tint on the selection circle. Nulled
       background = no ripple there; the ring/dot graphic comes from the
       button drawable and is unaffected, and the drawable has no intrinsic
       size so the row layout is pixel-identical. The whole row remains the
       single touch target (adapter sets rdoCheck.setClickable(false)). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/ripple_installed_row"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/rdo_check"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/img_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:textSize="14sp"
            android:id="@+id/txt_webview_name"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:textSize="10sp"
            android:id="@+id/txt_webview_package"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:textSize="10sp"
            android:id="@+id/txt_webview_version"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
