<?xml version="1.0" encoding="utf-8"?>
<!-- Press feedback for the "Installed" WebView rows (v6.27).
     Idle state: fully transparent — the row looks exactly like before.
     Pressed: the same dark highlight tint ?android:attr/selectableItemBackground
     produced (platform colorControlHighlight, day/night aware — Material 3
     does not override it), but bounded by a 12 dp rounded-rectangle mask so
     the feedback shape matches the app's MaterialButtons (e.g. the blue
     "Check for updates" button, app:cornerRadius="12dp") instead of a sharp
     rectangle. The radius here MUST stay in sync with the buttons' corner
     radius if that ever changes. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
