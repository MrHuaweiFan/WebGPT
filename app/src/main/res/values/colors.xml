    <!-- Page-progress bar (loading screen) — LIGHT-mode values. Both
         colors are pinned literals: indicator #2F628C (navy), track
         #CEE5FF (pale blue). Dark mode swaps the two (user request,
         v6.28 exp build) via the values-night/colors.xml overrides —
         light mode is what these literals define.
         loading_progress_indicator (#2F628C) paints the active indicator
         AND the stop dot (material 1.12 paints both from the indicator
         color): the light-mode "Apply & restart" button blue — the user
         preferred it on the dark loading screen over the tonal buttons'
         secondaryContainer. loading_progress_track (#CEE5FF, the LIGHT
         scheme's md_secondaryContainer) paints the full-width track: it
         must be pinned too, because the library's default track color
         is the colorSecondaryContainer THEME token, which re-resolves
         to the dark scheme's #0D4A73 navy at night and made the bar
         look wrong in dark mode. Do NOT "simplify" either to
         @color/md_* refs: a resource reference is re-resolved against
         the CURRENT configuration, so at night it would pick the dark
         scheme's values (#9BCBFB pastel primary / #0D4A73 track)
         instead of these literals. -->
    <color name="loading_progress_indicator">#2F628C</color>
    <color name="loading_progress_track">#CEE5FF</color>
</resources>
