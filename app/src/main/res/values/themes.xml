<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Material 3 theme using the color palette from the Material Theme Builder
      export the user provided (blue palette, seed #4189C3).

      Inherits from Theme.Material3.DayNight.NoActionBar so we get the full M3
      component styles (TopAppBar, MaterialCardView, MaterialButton, etc.).
      We override only the color tokens.
    -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_onPrimaryContainer</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_onSecondaryContainer</item>

        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_onTertiaryContainer</item>

        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_onError</item>
        <item name="colorErrorContainer">@color/md_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_onErrorContainer</item>

        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_onBackground</item>

        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_onSurfaceVariant</item>

        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outlineVariant</item>

        <!-- Status bar: explicit light/dark surface + matching icon tint.
             Material3 DayNight sets a slightly-off translucent color by
             default (e.g. #101418 in dark, #F7F9FF in light) which clashes
             with the actual app surface. Pin to pure #000000/#fcfcfc. -->
        <item name="android:statusBarColor">@color/status_bar_bg</item>
        <item name="android:navigationBarColor">@color/status_bar_bg</item>
        <item name="android:windowLightStatusBar">@bool/window_light_status_bar</item>
        <item name="android:windowLightNavigationBar">@bool/window_light_status_bar</item>
    </style>

    <!--
      v6.27 — Launch theme for MainActivity (Android 12+ splash screen).

      Goal: at launch the user sees EXACTLY the loading screen's background
      color and nothing else — no icon, no different tint, in light AND dark
      mode — so the hand-off into the app is a seamless crossfade with zero
      color flashing.

      What each item does:
      - windowSplashScreenBackground = @color/md_background: the same
        day/night-qualified color the in-app loading overlay is painted with
        (?android:attr/colorBackground, which AppTheme pins to md_background:
        #FCFCFC light / #000000 dark). Splash frame and first app frame are
        pixel-identical in the background.
        ⚠ FORKS: this MUST point at the DERIVATIVE'S OWN loading-screen
        background color token — every app in the family uses a different
        palette. See WEBSITE_SPECIFICS.md §3 "Launch splash".
      - windowSplashScreenAnimatedIcon = @drawable/splash_icon_none: a fully
        transparent shape, i.e. NO icon. The Android 12+ system splash
        renders this attribute inside its own fixed-size icon container
        (masked/scaled by the OEM), and a real logo there looked wrong on
        several devices. With no icon, the splash is a pure color frame; the
        loading screen's centered logo then fades in with the exit
        animation. (Never leave this unset — the library falls back to the
        framework's robot icon.)
      - postSplashScreenTheme = @style/AppTheme: installSplashScreen() swaps
        the real Material3 theme in before the content view is laid out.
      - android:windowBackground / statusBarColor / navigationBarColor /
        windowLightStatusBar: on Android < 12 there IS no system splash —
        the launch window itself is what the user sees until the content
        draws. The library's base splash themes resolve to
        DeviceDefault.LIGHT (no night variant in the AAR), which would
        flash a white window in dark mode. Pinning these to the same tokens
        AppTheme uses makes the pre-12 launch window byte-identical to the
        v6.26 behavior. On Android 12+ these are covered by the system
        splash and are harmless. (The windowLight* attributes are from
        newer APIs; older runtimes ignore them.)
    -->
    <style name="Theme.AppSplash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/md_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:windowBackground">@color/md_background</item>
        <item name="android:statusBarColor">@color/status_bar_bg</item>
        <item name="android:navigationBarColor">@color/status_bar_bg</item>
        <item name="android:windowLightStatusBar">@bool/window_light_status_bar</item>
        <item name="android:windowLightNavigationBar">@bool/window_light_status_bar</item>
    </style>

    <!--
      ShareRelayActivity theme: fully transparent framework theme. The relay
      is a sub-second trampoline that shows nothing — the sender's UI stays
      visible underneath while it forwards the share into WebGPT's own task.
      Uses the plain platform translucent theme (not Material3) so it works
      on every API level with zero component inflation.
    -->
    <style name="ShareRelayTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
