<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Trimmed to what the code actually uses: the WebView needs INTERNET +
         ACCESS_NETWORK_STATE; CAMERA/RECORD_AUDIO are requested on demand for
         voice mode and photo upload. WRITE_EXTERNAL_STORAGE is only used on
         Android 9 and below (Android 10+ saves via MediaStore). The unused
         location/wifi/vibrate/wake-lock/download permissions were removed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Camera is an optional feature (photo attach) — do not hide the app
         from camera-less devices like TV boxes and kiosk tablets. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!--
      Package-visibility declarations required for the in-app WebView switcher.
      On Android 11+ (API 30+) apps cannot see other installed packages unless
      they are listed here. Without these entries, PackageManager.getPackageInfo
      would throw NameNotFoundException for every WebView package except the
      system default, and the picker would show only one row.
    -->
    <queries>
        <package android:name="com.google.android.webview"/>
        <package android:name="com.google.android.webview.beta"/>
        <package android:name="com.google.android.webview.dev"/>
        <package android:name="com.google.android.webview.canary"/>
        <package android:name="com.android.webview"/>
        <package android:name="com.android.chrome"/>
        <package android:name="com.chrome.beta"/>
        <package android:name="com.chrome.dev"/>
        <package android:name="com.chrome.canary"/>
        <package android:name="com.amazon.webview.chromium"/>
        <package android:name="com.huawei.webview"/>
        <package android:name="us.spotco.mulch_wv"/>
        <package android:name="com.thorium.webview"/>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        tools:ignore="GoogleAppIndexingWarning">

        <!--
          Synthetic developer-mode content provider. The authority uses the
          chosen WebView package's name as a prefix (e.g.
          "com.thorium.webview.DeveloperModeContentProvider"). Chromium WebView
          queries this authority to read developer-mode flag overrides.

          This declaration in the manifest is only a fallback — at runtime
          Hooker.hookInstallContentProviders() reflectively installs the
          provider via ActivityThread.installContentProviders() with whatever
          authority matches the currently selected WebView. The manifest entry
          ensures the provider class is registered even if the runtime hook
          fails (e.g. on a future Android version that hides
          ActivityThread.installContentProviders).
        -->
        <provider
            android:name="com.webgpt.app.webview.DeveloperModeContentProvider"
            android:authorities="${applicationId}.DeveloperModeContentProvider"
            android:exported="false"
            android:enabled="true" />

        <!-- FileProvider so we can share downloaded images via ACTION_SEND -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- configChanges lists EVERY flag AAPT knows (mcc..fontWeightAdjustment):
             any value the system can change when the app enters/leaves
             split-screen, freeform/floating windows, desktop modes (Samsung
             DeX etc.), folds/unfolds, docks a keyboard, switches theme,
             font scale or locale. An unlisted value makes Android DESTROY
             and recreate the activity — and with it the WebView (symptom:
             the app "relaunches" with a full page reload whenever it is
             floated). Declaring all of them keeps the activity and the
             live WebView with its conversation untouched; recreation then
             only happens after real process death, which onCreate's
             WebView state-restore path handles. grammaticalGender (34+) and
             fontWeightAdjustment (33+) are ignored by older platforms.

             windowSoftInputMode=adjustResize (pattern taken from the AI
             Studio webclient): with no mode set, the system resolves
             adjustUnspecified heuristically per window type — some OEMs
             resolve differently inside floating/freeform windows, where a
             panned window leaves the composer under the keyboard and the
             page's visualViewport logic never sees a resize. Pinning
             adjustResize makes the window (and thus the WebView viewport)
             always shrink when the IME opens, which is what chatgpt.com's
             own keyboard handling expects. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|fontScale|colorMode|grammaticalGender|fontWeightAdjustment"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ============ SHARE TEXT / FILES INTO WEBGPT ============ -->

            <!-- Receive text shares ("Ask WebGPT" appears in the share menu
                 when sharing text from other apps) -->
            <intent-filter android:label="Ask WebGPT">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>

            <!-- Receive file shares (any file type — image, document, code, etc.) -->
            <intent-filter android:label="Send to WebGPT">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- "Ask WebGPT" in text selection menu (long-press text in any app) -->
            <intent-filter android:label="Ask WebGPT">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Trampoline for TEXT shares that were mis-launched into a foreign
          (sender's) task — see MainActivity.onCreate and ShareRelayActivity.
          Transparent: nothing flashes while it forwards the share into
          WebGPT's own task. noHistory: self-destructs the moment it is
          backgrounded. taskAffinity="": it owns no task of its own and can
          never spawn one. excludeFromRecents is deliberately NOT set — the
          relay lives in the SENDER's task, and that flag would hide the
          sender from Recents. No intent-filter: only MainActivity starts it,
          with an explicit in-app intent.
        -->
        <activity
            android:name=".ShareRelayActivity"
            android:exported="false"
            android:theme="@style/ShareRelayTheme"
            android:noHistory="true"
            android:taskAffinity="" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
